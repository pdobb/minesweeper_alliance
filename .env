# Values in this file (.env):
# - Should be generic to all local + deployment environments.
# - Must NEVER contain sensitive data like API keys or passwords.
#   (This is what encrypted credentials are for.)

# Ruby `debug` Gem
# See: https://github.com/ruby/debug?tab=readme-ov-file#using-irb-as-the-debug-console
RUBY_DEBUG_IRB_CONSOLE=1 # Use IRB Mode for breakpoints

HONEYBADGER_INSIGHTS_ENABLED=false
HONEYBADGER_DEVELOPMENT_ENVIRONMENTS=development,test,production_local

# Rack::MethodOverride parses POST bodies before Rails' exception app.
# A multipart body with no boundary in the first 16KB raises
# Rack::Multipart::BoundaryTooLongError, which becomes a 500 and a
# Honeybadger fault. These are bad clients, not application bugs.
# https://app.honeybadger.io/projects/129535/faults/131779454
HONEYBADGER_EXCEPTIONS_IGNORE=Rack::Multipart::BoundaryTooLongError,Rack::Multipart::MultipartPartLimitError,Rack::Multipart::MultipartTotalPartLimitError
