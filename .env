# Values in this file (.env):
# - Should be generic to all local + deployment environments.
# - Must NEVER contain sensitive data like API keys or passwords.
#   (This is what encrypted credentials are for.)

# Ruby `debug` Gem
# See: https://github.com/ruby/debug?tab=readme-ov-file#using-irb-as-the-debug-console
RUBY_DEBUG_IRB_CONSOLE=1 # Use IRB Mode for breakpoints
